---
import fs from "node:fs";
import path from "node:path";
import { TEMP_ILLUSTRATIONS } from "../data/tempIllustrations";

export interface Props {
  /** Nom de fichier sans extension, ex: "hero-terrasse" — voir IMAGES-A-FOURNIR.md */
  name: string;
  /** Texte alternatif descriptif, rédigé en français, jamais vide ni générique */
  alt: string;
  width: number;
  height: number;
  class?: string;
  /** Image prioritaire (LCP), ex: le hero : chargement eager + fetchpriority high */
  priority?: boolean;
}

const { name, alt, width, height, class: className = "", priority = false } = Astro.props;

const imagesDir = path.join(process.cwd(), "public", "images");
const hasWebp = fs.existsSync(path.join(imagesDir, `${name}.webp`));
const hasJpg = fs.existsSync(path.join(imagesDir, `${name}.jpg`));
const hasAny = hasWebp || hasJpg;
const isTemp = hasAny && TEMP_ILLUSTRATIONS.has(name);

const ratio = width / height;
---

{
  isTemp ? (
    <div class={`relative overflow-hidden ${className}`} style={`aspect-ratio: ${ratio};`}>
      <picture>
        {hasWebp && <source srcset={`/images/${name}.webp`} type="image/webp" />}
        <img
          src={hasJpg ? `/images/${name}.jpg` : `/images/${name}.webp`}
          alt={alt}
          width={width}
          height={height}
          loading={priority ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={priority ? "high" : "auto"}
          class="w-full h-full object-cover"
        />
      </picture>
      <span class="absolute left-2 top-2 sm:left-3 sm:top-3 rounded-full bg-navy/85 px-2.5 py-1 text-[10px] font-medium leading-none text-cream sm:text-xs">
        Illustration temporaire
      </span>
    </div>
  ) : hasAny ? (
    <picture>
      {hasWebp && <source srcset={`/images/${name}.webp`} type="image/webp" />}
      <img
        src={hasJpg ? `/images/${name}.jpg` : `/images/${name}.webp`}
        alt={alt}
        width={width}
        height={height}
        loading={priority ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={priority ? "high" : "auto"}
        class={className}
        style={`aspect-ratio: ${ratio};`}
      />
    </picture>
  ) : (
    <div
      class={`relative overflow-hidden bg-cream-dark ${className}`}
      style={`aspect-ratio: ${ratio};`}
      role="img"
      aria-label={alt}
    >
      <div
        class="absolute inset-0"
        style="background-image: repeating-linear-gradient(135deg, color-mix(in srgb, var(--color-navy) 7%, transparent) 0 2px, transparent 2px 16px);"
        aria-hidden="true"
      >
      </div>
      <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" class="text-navy/20">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <circle cx="9" cy="10" r="1.75" />
          <path d="m4 17 5-5 4 4 3-3 4 4" />
        </svg>
      </div>
      <span class="absolute left-2 top-2 sm:left-3 sm:top-3 max-w-[calc(100%-1rem)] truncate rounded-full bg-navy/85 px-2.5 py-1 text-[10px] font-medium leading-none text-cream sm:text-xs">
        Photo à venir · {name}
      </span>
    </div>
  )
}
