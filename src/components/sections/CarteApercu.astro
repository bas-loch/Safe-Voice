---
import { useTranslations, getLocalizedPath, type Lang } from "../../i18n/utils";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categoryKeys = ["antipasti", "pasta", "pesce", "pizza", "dolci"] as const;
---

<section id="carte" class="mx-auto max-w-6xl px-4 sm:px-6 py-20 sm:py-28">
  <div class="max-w-2xl mb-10 fade-in-up">
    <h2 class="font-serif text-3xl sm:text-4xl text-navy mb-3">{t.carteApercu.title}</h2>
    <p class="text-ink/80">{t.carteApercu.intro}</p>
  </div>

  <ul class="fade-in-up flex flex-wrap gap-3 mb-8">
    {
      categoryKeys.map((key) => (
        <li class="rounded-full border border-navy/20 px-4 py-2 text-sm text-navy/90">
          {t.carteApercu.categories[key]}
        </li>
      ))
    }
  </ul>

  <a
    href={getLocalizedPath(lang, "/carte")}
    class="fade-in-up inline-flex items-center rounded-full bg-navy text-cream px-6 py-3 min-h-11 text-sm sm:text-base font-medium hover:bg-navy-dark transition-colors"
  >
    {t.carteApercu.cta}
  </a>
</section>
