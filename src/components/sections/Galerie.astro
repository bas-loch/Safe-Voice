---
import Photo from "../Photo.astro";
import { useTranslations, type Lang } from "../../i18n/utils";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const photos = [
  { name: "terrasse-ambiance", alt: "Terrasse du restaurant Il Paradiso en service, ambiance du soir" },
  { name: "salle-interieur-01", alt: "Salle intérieure du restaurant Il Paradiso" },
  { name: "exterieur-facade", alt: "Façade extérieure du restaurant Il Paradiso à Hammamet" },
  { name: "galerie-01", alt: "Détail du restaurant Il Paradiso" },
  { name: "galerie-02", alt: "Produits frais du restaurant Il Paradiso" },
  { name: "galerie-03", alt: "Ambiance du restaurant Il Paradiso" },
  { name: "galerie-04", alt: "Vue depuis la terrasse du restaurant Il Paradiso" },
];
---

<section id="galerie" class="bg-cream-dark py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="fade-in-up font-serif text-3xl sm:text-4xl text-navy mb-10">{t.galerie.title}</h2>

    <div class="fade-in-up grid grid-cols-2 sm:grid-cols-3 gap-3">
      {
        photos.map((photo, index) => (
          <button
            type="button"
            data-gallery-trigger
            data-index={index}
            data-alt={photo.alt}
            class="group overflow-hidden rounded-lg aspect-square focus-visible:outline focus-visible:outline-2 focus-visible:outline-terracotta"
            aria-label={photo.alt}
          >
            <Photo
              name={photo.name}
              alt={photo.alt}
              width={1200}
              height={1200}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </button>
        ))
      }
    </div>
  </div>

  <dialog id="lightbox" class="m-auto max-w-[92vw] max-h-[92vh] bg-transparent p-0 backdrop:bg-navy/90">
    <div class="relative">
      <button
        type="button"
        data-lightbox-close
        class="absolute top-2 right-2 z-10 rounded-full bg-navy/80 text-cream w-11 h-11 flex items-center justify-center hover:bg-navy transition-colors"
        aria-label="Fermer"
      >
        ✕
      </button>
      <button
        type="button"
        data-lightbox-prev
        class="absolute left-2 top-1/2 -translate-y-1/2 z-10 rounded-full bg-navy/80 text-cream w-11 h-11 flex items-center justify-center hover:bg-navy transition-colors"
        aria-label="Photo précédente"
      >
        ‹
      </button>
      <img id="lightbox-image" src="" alt="" class="max-w-[92vw] max-h-[92vh] object-contain" />
      <button
        type="button"
        data-lightbox-next
        class="absolute right-2 top-1/2 -translate-y-1/2 z-10 rounded-full bg-navy/80 text-cream w-11 h-11 flex items-center justify-center hover:bg-navy transition-colors"
        aria-label="Photo suivante"
      >
        ›
      </button>
    </div>
  </dialog>
</section>

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-gallery-trigger]"));
  const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
  const image = document.getElementById("lightbox-image") as HTMLImageElement | null;

  if (dialog && image && triggers.length > 0) {
    let currentIndex = 0;

    const show = (index: number) => {
      currentIndex = (index + triggers.length) % triggers.length;
      const trigger = triggers[currentIndex];
      const img = trigger.querySelector("img");
      const alt = trigger.dataset.alt ?? "";
      if (img) {
        image.src = img.currentSrc || img.src;
      }
      image.alt = alt;
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener("click", () => {
        show(index);
        dialog.showModal();
      });
    });

    dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => show(currentIndex - 1));
    dialog.querySelector("[data-lightbox-next]")?.addEventListener("click", () => show(currentIndex + 1));

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") show(currentIndex + 1);
      if (event.key === "ArrowLeft") show(currentIndex - 1);
    });
  }
</script>
