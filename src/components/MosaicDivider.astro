---
// Le seul motif décoratif du site, inspiré du carreau de zellige tunisien.
// Utilisé une seule fois par emplacement, jamais en fond répété sur une section entière.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const id = `achiri-zellige-${Math.random().toString(36).slice(2, 8)}`;
---

<div class={`w-full overflow-hidden ${className}`} role="presentation" aria-hidden="true">
  <svg
    viewBox="0 0 160 28"
    preserveAspectRatio="xMidYMid meet"
    class="h-7 w-full"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id={id} width="24" height="28" patternUnits="userSpaceOnUse">
        <rect width="24" height="28" fill="none" />
        <path d="M12 4 L21 14 L12 24 L3 14 Z" fill="none" stroke="#1B5E86" stroke-width="1.4" opacity="0.65" />
        <circle cx="12" cy="14" r="2.4" fill="#C9873F" opacity="0.85" />
      </pattern>
    </defs>
    <rect width="160" height="28" fill={`url(#${id})`} />
  </svg>
</div>
