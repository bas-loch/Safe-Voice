---
interface Props {
  lang: 'fr' | 'en';
  frPath: string;
  enPath: string;
  variant?: 'dark' | 'light';
  class?: string;
}
const { lang, frPath, enPath, variant = 'dark', class: className = '' } = Astro.props;

const isLight = variant === 'light';
const border = isLight ? 'border-white/70' : 'border-hammamet-dark';
const idle = isLight ? 'text-white hover:bg-white/10' : 'text-hammamet-dark hover:bg-hammamet-dark/10';
const active = isLight ? 'bg-white text-hammamet-dark' : 'bg-hammamet-dark text-white';
---

<div class={`flex items-center border-2 ${border} text-xs font-bold ${className}`}>
  <a
    href={frPath}
    aria-current={lang === 'fr' ? 'page' : undefined}
    class={`px-2.5 py-1 ${lang === 'fr' ? active : idle}`}
  >
    FR
  </a>
  <a
    href={enPath}
    aria-current={lang === 'en' ? 'page' : undefined}
    class={`border-l-2 ${border} px-2.5 py-1 ${lang === 'en' ? active : idle}`}
  >
    EN
  </a>
</div>
