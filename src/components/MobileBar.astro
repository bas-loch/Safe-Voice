---
import cafe from '../data/cafe.json';

interface Props {
  t: any;
  lang: 'fr' | 'en';
}
const { t, lang } = Astro.props;
const telHref = cafe.telephone ? `tel:${cafe.telephone}` : undefined;
---

<nav
  aria-label={lang === 'fr' ? 'Actions rapides' : 'Quick actions'}
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-hammamet/15 bg-white text-hammamet-dark shadow-[0_-2px_10px_rgba(0,0,0,0.06)] md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <a
    href={cafe.googleMapsDirectionsUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t.mobilebar.itineraire}
    class="flex min-h-[56px] flex-col items-center justify-center gap-0.5 text-xs font-medium hover:bg-hammamet/5"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M3 11l18-8-8 18-2-8-8-2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    </svg>
    {t.mobilebar.itineraire}
  </a>

  {telHref ? (
    <a
      href={telHref}
      aria-label={t.mobilebar.appeler}
      class="flex min-h-[56px] flex-col items-center justify-center gap-0.5 border-x border-hammamet/15 text-xs font-medium hover:bg-hammamet/5"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M5 4h3l1.5 4-2 1.5a11 11 0 0 0 5 5l1.5-2 4 1.5v3a1 1 0 0 1-1 1C10.5 18.5 5.5 13.5 4 5.5A1 1 0 0 1 5 4Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </svg>
      {t.mobilebar.appeler}
    </a>
  ) : (
    <span
      aria-disabled="true"
      class="flex min-h-[56px] flex-col items-center justify-center gap-0.5 border-x border-hammamet/15 text-xs font-medium text-ink/35"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M5 4h3l1.5 4-2 1.5a11 11 0 0 0 5 5l1.5-2 4 1.5v3a1 1 0 0 1-1 1C10.5 18.5 5.5 13.5 4 5.5A1 1 0 0 1 5 4Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </svg>
      {t.mobilebar.appeler}
    </span>
  )}

  <a
    href={cafe.facebookUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t.mobilebar.facebook}
    class="flex min-h-[56px] flex-col items-center justify-center gap-0.5 text-xs font-medium hover:bg-hammamet/5"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M14 9h2V6h-2c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.2l.8-3H14V9.5c0-.3.2-.5.5-.5Z"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"
      />
    </svg>
    {t.mobilebar.facebook}
  </a>
</nav>
