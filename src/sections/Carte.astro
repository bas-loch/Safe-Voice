---
import MosaicDivider from '../components/MosaicDivider.astro';
import carte from '../data/carte.json';

interface Props {
  t: any;
  lang: 'fr' | 'en';
}
const { t, lang } = Astro.props;
---

<section id="carte" class="bg-white py-16 sm:py-24">
  <MosaicDivider class="mb-16 sm:mb-24" />
  <div class="mx-auto max-w-2xl px-4">
    <h2 class="text-3xl font-semibold text-hammamet-dark">{t.carte.titre}</h2>
    <p class="mt-2 text-ink/70">{t.carte.intro}</p>

    <ul class="mt-10 space-y-5">
      {carte.items.map((item) => (
        <li class="flex items-baseline gap-3">
          <span class="whitespace-nowrap font-display text-xl text-ink">
            {lang === 'fr' ? item.fr : item.en}
          </span>
          <span class="-translate-y-1 flex-1 border-b-2 border-dotted border-hammamet/25" aria-hidden="true" />
          <span class="whitespace-nowrap text-sm font-semibold text-hammamet-dark">
            {item.price ?? (item.id === 'cafe-direct' ? t.carte.prixIndicatif : t.carte.prixConfirmer)}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
