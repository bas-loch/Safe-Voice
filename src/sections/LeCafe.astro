---
import Photo from '../components/Photo.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section id="le-cafe" class="mx-auto max-w-5xl px-4 py-16 sm:py-24">
  <div class="grid items-start gap-10 sm:grid-cols-[1.1fr_0.9fr] sm:gap-16">
    <div class="sm:pt-6">
      <h2 class="text-3xl font-semibold text-hammamet-dark">{t.lecafe.titre}</h2>
      <p class="mt-4 text-base leading-relaxed text-ink/90">{t.lecafe.p1}</p>
      <p class="mt-4 text-base leading-relaxed text-ink/90">{t.lecafe.p2}</p>
    </div>
    <div class="print-frame mx-auto max-w-xs -rotate-2 p-2 sm:mx-0 sm:max-w-none">
      <Photo
        src="exterieur-facade.webp"
        alt={t.photos.exterieurFacade}
        width={640}
        height={853}
        class="w-full object-cover"
      />
    </div>
  </div>
</section>
