---
import Photo from '../components/Photo.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section id="le-cafe" class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
  <div class="grid items-center gap-8 sm:grid-cols-2 sm:gap-12">
    <div>
      <h2 class="text-3xl font-semibold text-hammamet-dark">{t.lecafe.titre}</h2>
      <p class="mt-4 text-base leading-relaxed text-ink/90">{t.lecafe.p1}</p>
      <p class="mt-4 text-base leading-relaxed text-ink/90">{t.lecafe.p2}</p>
    </div>
    <Photo
      src="exterieur-facade.webp"
      alt={t.photos.exterieurFacade}
      width={640}
      height={853}
      class="w-full rounded-lg object-cover shadow-sm"
    />
  </div>
</section>
