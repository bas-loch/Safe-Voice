---
import Photo from '../components/Photo.astro';

interface Props {
  t: any;
  lang: 'fr' | 'en';
}
const { t, lang } = Astro.props;

const photos = [
  { src: 'interieur-salle.webp', alt: t.photos.interieurSalle, width: 640, height: 853, rotate: '-rotate-1' },
  { src: 'exterieur-facade.webp', alt: t.photos.exterieurFacade, width: 640, height: 853, rotate: 'rotate-1' },
  { src: 'galerie-01.webp', alt: t.photos.galerie01, width: 560, height: 747, rotate: 'rotate-2' },
  { src: 'galerie-02.webp', alt: t.photos.galerie02, width: 560, height: 747, rotate: '-rotate-2' },
  { src: 'galerie-03.webp', alt: t.photos.galerie03, width: 560, height: 747, rotate: 'rotate-1' },
];

const closeLabel = lang === 'fr' ? 'Fermer' : 'Close';
const prevLabel = lang === 'fr' ? 'Photo précédente' : 'Previous photo';
const nextLabel = lang === 'fr' ? 'Photo suivante' : 'Next photo';
---

<section id="galerie" class="mx-auto max-w-5xl px-4 py-16 sm:py-24">
  <h2 class="text-3xl font-semibold text-hammamet-dark">{t.galerie.titre}</h2>

  <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3">
    {photos.map((p, i) => (
      <button
        type="button"
        class={`print-frame group relative block aspect-[3/4] p-2 transition-transform hover:z-10 hover:scale-105 hover:rotate-0 ${p.rotate}`}
        data-lightbox-index={i}
        aria-label={p.alt}
      >
        <Photo src={p.src} alt={p.alt} width={p.width} height={p.height} class="h-full w-full object-cover" />
      </button>
    ))}

    <div class="print-frame relative block aspect-[3/4] rotate-2 p-2" aria-hidden="false">
      <Photo
        src="detail-cafe-turc.webp"
        alt={t.photos.detailCafeTurc}
        width={560}
        height={747}
        class="h-full w-full object-cover"
      />
    </div>
  </div>

  <dialog
    id="lightbox"
    class="w-full max-w-3xl bg-transparent p-0 backdrop:bg-ink/85"
    aria-label={t.galerie.titre}
  >
    <div class="relative">
      <button
        id="lightbox-close"
        type="button"
        aria-label={closeLabel}
        class="absolute right-2 top-2 flex h-11 w-11 items-center justify-center bg-white/90 text-ink hover:bg-white"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
      <img id="lightbox-img" src="" alt="" class="max-h-[80vh] w-full object-contain" />
      <button
        id="lightbox-prev"
        type="button"
        aria-label={prevLabel}
        class="absolute left-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center bg-white/90 text-ink hover:bg-white"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button
        id="lightbox-next"
        type="button"
        aria-label={nextLabel}
        class="absolute right-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center bg-white/90 text-ink hover:bg-white"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </dialog>
</section>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-index]'));
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  if (dialog && img && buttons.length) {
    let current = 0;

    const show = (index: number) => {
      current = (index + buttons.length) % buttons.length;
      const source = buttons[current].querySelector('img');
      if (source) {
        img.src = source.src;
        img.alt = source.alt;
      }
    };

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => dialog.close());
    prevBtn?.addEventListener('click', () => show(current - 1));
    nextBtn?.addEventListener('click', () => show(current + 1));

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
