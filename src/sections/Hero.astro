---
import Photo from '../components/Photo.astro';
import cafe from '../data/cafe.json';

interface Props {
  t: any;
}
const { t } = Astro.props;
const telHref = cafe.telephone ? `tel:${cafe.telephone}` : undefined;
---

<section class="relative">
  <div class="relative h-[70vh] min-h-[420px] w-full overflow-hidden sm:h-[80vh]">
    <Photo
      src="hero-terrasse.webp"
      alt={t.photos.hero}
      width={900}
      height={675}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/25 to-ink/10" aria-hidden="true" />

    <div class="absolute inset-x-0 bottom-0 px-4 pb-8 text-white sm:pb-10">
      <div class="mx-auto max-w-5xl">
        <p class="mb-2 text-sm font-medium uppercase tracking-wide text-white/85">{t.hero.kicker}</p>
        <h1 class="font-display text-4xl font-semibold sm:text-5xl">{t.footer.titre}</h1>
        <p class="mt-2 max-w-md text-lg text-white/95 sm:text-xl">{t.hero.tagline}</p>

        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href={cafe.googleMapsDirectionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.hero.ctaItineraire}
            class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-hammamet px-5 py-2.5 text-sm font-semibold text-white hover:bg-hammamet-light"
          >
            {t.hero.ctaItineraire}
          </a>
          {telHref ? (
            <a
              href={telHref}
              aria-label={t.hero.ctaAppeler}
              class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-hammamet-dark hover:bg-white/90"
            >
              {t.hero.ctaAppeler}
            </a>
          ) : (
            <span
              aria-disabled="true"
              title={t.hero.ctaAppelerIndisponible}
              class="inline-flex min-h-[44px] cursor-not-allowed items-center justify-center rounded-md border border-white/50 px-5 py-2.5 text-sm font-semibold text-white/70"
            >
              {t.hero.ctaAppeler}
            </span>
          )}
        </div>
      </div>
    </div>
  </div>

  <div class="border-b border-hammamet/10 bg-white">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 text-sm text-ink/80">
      <span class="flex items-center gap-1.5 font-medium text-hammamet-dark">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 2.5l2.7 6 6.6.6-5 4.4 1.5 6.5-5.8-3.5-5.8 3.5 1.5-6.5-5-4.4 6.6-.6Z"
            fill="#C9873F"
            stroke="#C9873F"
          />
        </svg>
        4,3/5 {t.hero.ratingText}
      </span>
      <span>{t.hero.repere}</span>
    </div>
  </div>
</section>
