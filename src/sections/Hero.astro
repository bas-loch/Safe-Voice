---
import Photo from '../components/Photo.astro';
import cafe from '../data/cafe.json';

interface Props {
  t: any;
}
const { t } = Astro.props;
const telHref = cafe.telephone ? `tel:${cafe.telephone}` : undefined;
---

<section class="relative">
  <div class="h-[46vh] min-h-[280px] w-full overflow-hidden sm:h-[56vh]">
    <Photo
      src="hero-terrasse.webp"
      alt={t.photos.hero}
      width={900}
      height={675}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
  </div>

  <div class="border-b-4 border-ocre bg-hammamet-dark px-4 py-8 text-white sm:py-10">
    <div class="mx-auto max-w-5xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ocre">{t.hero.kicker}</p>
      <h1 class="mt-2 font-display text-5xl font-semibold leading-[0.95] sm:text-7xl">
        {t.footer.titre}
      </h1>
      <p class="mt-3 max-w-md text-lg text-white/90 sm:text-xl">{t.hero.tagline}</p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={cafe.googleMapsDirectionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.hero.ctaItineraire}
          class="btn-fill"
        >
          {t.hero.ctaItineraire}
        </a>
        {telHref ? (
          <a href={telHref} aria-label={t.hero.ctaAppeler} class="btn-outline-light">
            {t.hero.ctaAppeler}
          </a>
        ) : (
          <span aria-disabled="true" title={t.hero.ctaAppelerIndisponible} class="btn-disabled">
            {t.hero.ctaAppeler}
          </span>
        )}
      </div>
    </div>
  </div>

  <div class="border-b border-hammamet/10 bg-white">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 text-sm text-ink/80">
      <span class="flex items-center gap-1.5 font-medium text-hammamet-dark">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 2.5l2.7 6 6.6.6-5 4.4 1.5 6.5-5.8-3.5-5.8 3.5 1.5-6.5-5-4.4 6.6-.6Z"
            fill="#C9873F"
            stroke="#C9873F"
          />
        </svg>
        4,3/5 {t.hero.ratingText}
      </span>
      <span>{t.hero.repere}</span>
    </div>
  </div>
</section>
